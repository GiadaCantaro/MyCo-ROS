<?xml version="1.0" encoding="UTF-8"?>
<robot name="MyCo-10-1.00">
    <group name="myco_arm">
        <chain base_link="myco_base_link" tip_link="tcp"/>
    </group>
    
    <group name="gripper">
        <link name="onrobot_vgc10_base_link"/>
        <link name="suction"/>
        <link name="tcp"/>
    </group>

    <group_state name="home" group="myco_arm">
        <joint name="myco_joint1" value="0"/>
        <joint name="myco_joint2" value="0"/>
        <joint name="myco_joint3" value="0"/>
        <joint name="myco_joint4" value="0"/>
        <joint name="myco_joint5" value="0"/>
        <joint name="myco_joint6" value="0"/>
    </group_state>

    <end_effector name="gripper_ee" parent_link="myco_end_link" group="gripper" parent_group="myco_arm"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="myco_base_link"/>

    <disable_collisions link1="myco_base" link2="myco_link1" reason="Adjacent"/>
    <disable_collisions link1="myco_base" link2="myco_link2" reason="Never"/>
    <disable_collisions link1="myco_base" link2="myco_link3" reason="Never"/>
    
    <disable_collisions link1="myco_link1" link2="myco_link2" reason="Adjacent"/>
    <disable_collisions link1="myco_link1" link2="myco_link3" reason="Never"/>
    <disable_collisions link1="myco_link1" link2="myco_link4" reason="Never"/>
    <disable_collisions link1="myco_link1" link2="myco_link5" reason="Never"/>
    <disable_collisions link1="myco_link1" link2="myco_link6" reason="Never"/>
    
    <disable_collisions link1="myco_link2" link2="myco_link3" reason="Adjacent"/>
    <disable_collisions link1="myco_link2" link2="myco_link4" reason="Never"/>
    <disable_collisions link1="myco_link2" link2="myco_link5" reason="Never"/>
    <disable_collisions link1="myco_link2" link2="myco_link6" reason="Never"/>
    
    <disable_collisions link1="myco_link3" link2="myco_link4" reason="Adjacent"/>
    <disable_collisions link1="myco_link3" link2="myco_link5" reason="Never"/>
    <disable_collisions link1="myco_link3" link2="myco_link6" reason="Never"/>
    <disable_collisions link1="myco_link3" link2="onrobot_vgc10_base_link" reason="Never"/>
    <disable_collisions link1="myco_link3" link2="suction" reason="Never"/>
    
    <disable_collisions link1="myco_link4" link2="myco_link5" reason="Adjacent"/>
    <disable_collisions link1="myco_link4" link2="myco_link6" reason="Never"/>
    <disable_collisions link1="myco_link4" link2="onrobot_vgc10_base_link" reason="Never"/>
    <disable_collisions link1="myco_link4" link2="suction" reason="Never"/>
    
    <disable_collisions link1="myco_link5" link2="myco_link6" reason="Adjacent"/>
    <disable_collisions link1="myco_link5" link2="myco_end_link" reason="Never"/>
    <disable_collisions link1="myco_link5" link2="onrobot_vgc10_base_link" reason="Never"/>
    <disable_collisions link1="myco_link5" link2="suction" reason="Never"/>
    
    <disable_collisions link1="myco_link6" link2="myco_end_link" reason="Adjacent"/>
    <disable_collisions link1="myco_link6" link2="onrobot_vgc10_base_link" reason="Never"/>
    <disable_collisions link1="myco_link6" link2="suction" reason="Never"/>
    
    <disable_collisions link1="myco_end_link" link2="onrobot_vgc10_base_link" reason="Adjacent"/>
    <disable_collisions link1="myco_end_link" link2="suction" reason="Never"/>
    
    <disable_collisions link1="onrobot_vgc10_base_link" link2="suction" reason="Adjacent"/>
    <disable_collisions link1="suction" link2="tcp" reason="Adjacent"/>
    <disable_collisions link1="onrobot_vgc10_base_link" link2="tcp" reason="Adjacent"/>
    <disable_collisions link1="myco_end_link" link2="tcp" reason="Never"/>
</robot>